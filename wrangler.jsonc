{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "simulateur",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/devises"]
  },
  "observability": {\n    "enabled": true,\n    "head_sampling_rate": 1\n  },\n  "routes": [
    { "pattern": "simulateur.site/*", "zone_name": "simulateur.site" }
  ]
}