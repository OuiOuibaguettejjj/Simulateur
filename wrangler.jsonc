{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "simulateur",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/devises", "/go", "/go/"]
  },
  "analytics_engine_datasets": [
    { "binding": "CLICK_ANALYTICS", "dataset": "simulateur_clicks" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "simulateur.site/*", "zone_name": "simulateur.site" }
  ]
}